{
    "name": "BrowserQuest"
  , "version": "0.0.1"
  , "private": true
  , "scripts": {
    "start": "node server/js/main.js"
    , "client": "http-server . -p 8080 -c-1"
    , "equipment:build": "node tools/equipment/build.js"
    , "npcs:build": "node tools/npcs/build.js"
    , "prestart": "node tools/equipment/build.js && node tools/npcs/build.js"
  }
  , "dependencies": {
    "underscore": "1.8.3"
    , "log": "1.4.0"
    , "bison": "1.1.1"
    , "ws": "8.18.0"
    , "sanitizer": "0.1.3"
    , "memcache": "1.12.0"
  }
  , "devDependencies": {
    "http-server": "14.1.1"
  }
  , "engines": {
    "node": ">=18"
  }
}
